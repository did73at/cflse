#!/bin/sh


i3lock(){
    if pgrep -f "i3_menu" > /dev/null; then
        pkill -f "i3_menu"
    fi
    bash -c 'while true; do i3lock; sleep 180; done' i3_menu &
}

stop_autolock(){
    pkill -f "i3_menu"
}

dMenu() {
    choice=$(
      {
        echo "confloose"
        echo "stop"
        compgen -c
      } | sort -u | dmenu -i -p ""
    )

    case "$choice" in
        firefox) exec sh -c "firefox 'https://youtu.be/dQw4w9WgXcQ?si=JfrV837JqMz8R8BI'" ;;
        i3lock) i3lock;;
        confloose) exec sh -c "bash $HOME/.config/ssh/anticflse";;
        stop) stop_autolock;;
        *) exec "$choice" ;;
    esac
}
